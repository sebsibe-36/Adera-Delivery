rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 150)) &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 1000));
    }

    function isValidOrder(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.orderNumber is string && data.orderNumber.size() <= 50 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.items is list && data.items.size() >= 1 && data.items.size() <= 50 &&
             data.subtotal is number && data.subtotal >= 0 &&
             (!('deliveryFee' in data) || (data.deliveryFee is number && data.deliveryFee >= 0)) &&
             data.total is number && data.total >= 0 &&
             data.status in ['RECEIVED', 'PREPARING', 'READY_FOR_DELIVERY', 'DELIVERED'] &&
             (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 100)) &&
             (!('customerPhone' in data) || (data.customerPhone is string && data.customerPhone.size() <= 50)) &&
             (!('deliveryAddress' in data) || (data.deliveryAddress is string && data.deliveryAddress.size() <= 300)) &&
             (!('deliveryNotes' in data) || (data.deliveryNotes is string && data.deliveryNotes.size() <= 500)) &&
             (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 100)) &&
             (!('estimatedArrival' in data) || (data.estimatedArrival is string && data.estimatedArrival.size() <= 100)) &&
             (!('driverName' in data) || (data.driverName is string && data.driverName.size() <= 100)) &&
             (!('driverPhone' in data) || (data.driverPhone is string && data.driverPhone.size() <= 50));
    }

    function isValidFavorite(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.itemId is string && data.itemId.size() <= 128 &&
             (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
             data.type in ['food', 'restaurant'] &&
             data.userId is string && data.userId.size() <= 128;
    }

    // User profile document
    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time)) &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'updatedAt']);

      allow delete: if false;

      // User orders subcollection
      match /orders/{orderId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(orderId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().id == orderId &&
                         incoming().keys().hasAll(['id', 'orderNumber', 'userId', 'items', 'subtotal', 'total', 'status', 'createdAt']) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidOrder(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(orderId) &&
                         incoming().userId == existing().userId &&
                         incoming().id == existing().id &&
                         incoming().createdAt == existing().createdAt &&
                         (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time)) &&
                         isValidOrder(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

        allow delete: if false;
      }

      // User favorites subcollection
      match /favorites/{favoriteId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(favoriteId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().id == favoriteId &&
                         incoming().keys().hasAll(['id', 'itemId', 'type', 'userId', 'addedAt']) &&
                         incoming().addedAt is timestamp &&
                         incoming().addedAt <= request.time &&
                         isValidFavorite(incoming());

        allow delete: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(favoriteId);
      }
    }
  }
}
